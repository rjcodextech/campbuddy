<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---- Speed -----------------------------------------------------------------
# Each block is skipped if the module isn't enabled, so this can't break a host.

# Pages, styles, scripts and JSON travel as a fraction of their size.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Vite's build files carry a content hash in their name (a new build is a new
    # URL), so a browser can keep them for good.
    <If "%{REQUEST_URI} =~ m#^/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Logos and icons keep their names when they change, so: a day, then ask again.
    <If "%{REQUEST_URI} =~ m#^/media/#">
        Header set Cache-Control "public, max-age=86400"
    </If>

    # The rules below use <Files>/<FilesMatch>, not <If>: the live host runs
    # LiteSpeed, which quietly ignores <If> blocks (the two rules above never
    # apply there) but honours <Files> and <FilesMatch> — as Apache does too.

    # The service worker keeps its name when it changes, and a new version must
    # reach every phone (and a CDN's edge) as soon as it is deployed — never
    # held back by an old copy. no-cache = always ask the server first.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>

    # sw-flags.json is the service worker's on/off switch (see sw.js): a change
    # must be seen at once, everywhere.
    <Files "sw-flags.json">
        Header set Cache-Control "no-store"
    </Files>

    # The list of build files (public/build/manifest.json) changes with every
    # build while keeping its name; the offline warm-up reads it, so a CDN must
    # not keep serving an old one.
    <Files "manifest.json">
        Header set Cache-Control "no-cache"
    </Files>

    # Build files carry a content hash in their name (app-QTB9up0X.js): safe to
    # keep for good. Same intent as the /build/assets rule above, in a form
    # LiteSpeed applies. Only .js/.css — other files (/media) keep their names.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
