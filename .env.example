APP_NAME=CampBuddy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campbuddy_v2
DB_USERNAME=campbuddy
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 measurement ID (attendee app only). Leave empty to
# disable analytics entirely — set it on production only.
GA_MEASUREMENT_ID=

# Only for `php artisan campbuddy:ga-setup`, which registers every CampBuddy
# event parameter as a GA custom dimension/metric so it shows in reports.
# Numeric property ID (GA Admin → Property details), and a Google Cloud
# service account JSON key with Editor access to that property.
GA_PROPERTY_ID=
GA_CREDENTIALS_PATH=

# Web Push (VAPID) — generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"

# Timezone the scheduler runs in — "daily at midnight" (the nightly attendee
# roster refresh) means midnight here. Defaults to UTC.
# APP_TIMEZONE=Asia/Kolkata

# Optional: lets the admin "Purge cache & refresh data" button also purge
# Cloudflare. Use an API token with ONLY Zone → Cache Purge → Purge on this zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Production checklist (see the deployment docs):
#   APP_ENV=production  APP_DEBUG=false  APP_URL=https://your-domain
#   SESSION_SECURE_COOKIE=true
#   QUEUE_CONNECTION=database  — jobs are worked off by the scheduler's
#   once-a-minute cron entry; no separate queue worker is needed.

# Search engines (optional). Paste only the content="…" value of the
# "HTML tag" verification method. IndexNow works without any setup.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# API limits per minute (config/campbuddy.php). Counted per phone, so shared
# venue wifi or mobile-network addresses don't throttle everyone together.
# Raise for a very large event; the defaults suit a few thousand attendees.
RATE_LIMIT_DEVICE_READS=120
RATE_LIMIT_DEVICE_WRITES=40
RATE_LIMIT_ADDRESS_READS=3000
RATE_LIMIT_ADDRESS_WRITES=600
RATE_LIMIT_ANONYMOUS_READS=300
RATE_LIMIT_ANONYMOUS_WRITES=60

# The Studio folder shared with WPSimplified (config/campbuddy.php): audio, video
# and creative files, outside the web root, never in git or the FTP upload.
# Social media → Reels → Music offers its music library. Left empty, CampBuddy
# uses the first of E:/Sites/InHouse/wpsimplified/Studio (local) and
# /home/mzpjfuem/domains/Studio (server) that exists.
# Server: STUDIO_PATH=/home/mzpjfuem/domains/Studio
STUDIO_PATH=

# ---------------------------------------------------------------------------
# CampBuddy settings. The values below are the defaults the code already uses
# (nothing changes if you leave them); commented ones are optional.
# ---------------------------------------------------------------------------

# The first /admin login, made by `php artisan db:seed --class=AdminUserSeeder`.
ADMIN_EMAIL=hello@wpsimplified.in

# Who runs CampBuddy and where data requests and complaints go (DPDP Act 2023):
# shown in the privacy notice, the website footer and the app.
LEGAL_ENTITY=WPSimplified
LEGAL_GRIEVANCE_EMAIL=hello@wpsimplified.in

# API handshake (config/campbuddy.php). Keep STRICT=false until every phone runs
# an app version that sends the handshake headers; MAX_SKEW is how far (seconds)
# a phone's clock may be off.
API_HANDSHAKE_STRICT=false
API_HANDSHAKE_MAX_SKEW=300

# Native app (config/mobile_app.php).
MOBILE_APP_ID=club.campbuddy.app
# Android App Links: SHA-256 certificate fingerprints, comma-separated ("AA:BB:…"),
# the Play App Signing key as well as the upload key.
# MOBILE_ANDROID_SHA256=
# iOS Universal Links: the Apple Developer Team ID.
# MOBILE_APPLE_TEAM_ID=
# Oldest app version each platform may still run; older ones see "Update the app".
# Raise only once the new version is out.
MOBILE_MIN_VERSION_ANDROID=0.0.1
MOBILE_MIN_VERSION_IOS=0.0.1
# Store pages the update screen opens.
# MOBILE_STORE_URL_ANDROID=
# MOBILE_STORE_URL_IOS=
# Switches the app reads on start: turn a native feature off without a store release.
MOBILE_FEATURE_NATIVE_PUSH=true
MOBILE_FEATURE_LOCAL_REMINDERS=true

# Push to the native app (Firebase Cloud Messaging): the Firebase project ID and
# a service-account JSON key file outside the web root. Unset = no native push
# (Web Push still works). See .claude/skills/campbuddy-docs/mobile/SETUP.md.
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=

# Where IndexNow pings go (the default reaches every IndexNow search engine).
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Proxies whose X-Forwarded-* headers are trusted, comma-separated IPs/CIDRs.
# Unset = Cloudflare's published ranges + localhost (bootstrap/app.php), right
# behind Cloudflare.
# TRUSTED_PROXIES=

# Old APP_KEYs, comma-separated, so data encrypted with them still opens after
# a key rotation.
# APP_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Laravel options, rarely needed. All commented out: each shows the default the
# config uses (config/*.php). Uncomment only to change one.
# ---------------------------------------------------------------------------

# Auth (config/auth.php)
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# Database (config/database.php)
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_FOREIGN_KEYS=true
# MYSQL_ATTR_SSL_CA=
# DB_SSLMODE=prefer
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# Redis (config/database.php, cache, queue)
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_CLUSTER=redis
# REDIS_PREFIX=                    (default: the app name, slugged, + "-database-")
# REDIS_PERSISTENT=false
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# Cache (config/cache.php)
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# Queue (config/queue.php)
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# Session (config/session.php). On production also SESSION_SECURE_COOKIE=true.
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_TABLE=sessions
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false

# Logging (config/logging.php)
# LOG_DAILY_DAYS=14
# LOG_DEPRECATIONS_TRACE=false
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=              (default: APP_NAME)
# LOG_SLACK_EMOJI=:boom:
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=          (default: Monolog SyslogUdpHandler)
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=             (default: LOG_USER)

# Mail (config/mail.php, config/services.php)
# MAIL_URL=
# MAIL_EHLO_DOMAIN=                (default: the host of APP_URL)
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAIL_LOG_CHANNEL=
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=

# Files on S3-compatible storage (config/filesystems.php), with the AWS_* above
# AWS_URL=
# AWS_ENDPOINT=

# Slack notifications (config/services.php)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
