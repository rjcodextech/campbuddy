{
  "name": "campbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "CampBuddy · WordCamp Rajasthan 2026 companion PWA",
  "scripts": {
    "build": "sass scss/main.scss styles.css --style=compressed --no-source-map",
    "build:dev": "sass scss/main.scss styles.css --style=expanded --source-map",
    "watch": "sass --watch scss/main.scss:styles.css --style=expanded --source-map"
  },
  "devDependencies": {
    "sass": "^1.79.4"
  }
}
