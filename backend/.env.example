APP_ENV=production
APP_DEBUG=false

# Base URL of the site (no trailing slash) — used for absolute links, cookie domain, HSTS decisions.
APP_URL=https://campbuddy.club

# MySQL/MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campbuddy
DB_USERNAME=campbuddy
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Upstream WPSimplified API (server-side fetch only — never exposed to the client)
UPSTREAM_API_BASE=https://wpsimplified.in/wp-json/wpsimplified/v1
# One-time bootstrap default only — once the app has run, the live value
# lives in the app_settings DB table and is edited from /backend/admin.
EVENT_SLUG=wordcamp-rajasthan-2026

# Where the backend is mounted under the site's docroot (must match the
# root .htaccess rewrite rule), e.g. https://yoursite.example/backend/.
BACKEND_MOUNT_PATH=/backend

# How long a cached payload is considered fresh before the read-path
# self-heal (stale-while-revalidate) kicks in. The cron job below should
# run at roughly this interval.
CACHE_TTL_SECONDS=900

# Random 64+ char string, e.g.: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=change-me-to-a-random-64-char-string

# Session cookie lifetime (admin area only)
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=7200

# Public API rate limit (defense-in-depth; Cache-Control + a CDN is the real scale protection)
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

LOG_PATH=storage/logs/app.log
