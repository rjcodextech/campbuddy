{
    "name": "campbuddy/backend",
    "description": "CampBuddy Slim Framework backend: event auto-fetch, cache store, admin",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CampBuddy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CampBuddy\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
