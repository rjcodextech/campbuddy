RewriteEngine On

# Force HTTPS in production (redundant if the host already does this, but
# safe either way) — skipped automatically for local dev hosts (localhost,
# 127.0.0.1, *.test, *.local) that don't have a certificate, so the same
# file works unmodified in both places. No SSL is configured on this local
# WAMP install (mod_ssl is disabled, no cert present); see README.md's
# "Local HTTPS (optional)" section to add real local SSL via mkcert if
# wanted, rather than this app doing it silently.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.+\.test|.+\.local)$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Everything under /backend/ (API + admin panel) goes to the Slim front
# controller — including direct guesses at real paths like backend/.env or
# backend/vendor/..., which this rewrite swallows before they ever resolve
# on disk (backend/.htaccess's "Require all denied" is a second layer in
# case this rewrite is ever bypassed). Slim reads the path from REQUEST_URI
# (not PATH_INFO) and strips the /backend prefix itself via setBasePath(),
# so this internal rewrite doesn't need to touch the path any further.
# Everything else (index.html, app.js, styles.css, wcr/*, etc.) continues
# to be served as static files, completely untouched.
RewriteRule ^backend(/.*)?$ backend/public/index.php [L]

# Never serve dotfiles (.env, .git, .htaccess itself, etc.) directly.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>
