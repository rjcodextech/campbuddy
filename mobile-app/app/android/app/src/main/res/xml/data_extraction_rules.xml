<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device-to-device copy of app data: the discovery owner
     token must stay on the phone it was made on (moving it is the in-app
     "Move to a new phone" flow). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
